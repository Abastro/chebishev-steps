  {
   "kind": 2,
   "value": "lamFactor[poly_] := If[PolynomialRemainder[poly, lam, lam] == 0, PolynomialQuotient[poly, lam, lam], poly]\nremarkProp[ns_, ns2_, k_, k2_] := With[{\n    smallEqual := cFrac[ns[[k ;; 1 ;; -1]]] - cFrac[ns2[[k2 ;; 1 ;; -1]]] // Together // Numerator // SimplifyExpand,\n    largeInfinite := cFrac[Catenate[{ ns2[[1 ;; k2-1]], {ns2[[k2]] - ns[[k]]} , - ns[[k-1 ;; 1 ;; -1]] }]] // Together // Denominator // SimplifyExpand\n  }, TestCreate[(smallEqual - lamFactor[largeInfinite]) // SimplifyExpand, 0, TestID -> ToString[{k, k2}]]]\nCatenate[Table[remarkProp[SymbolList[\"n\", 1, k], SymbolList[\"m\", 1, k2], k, k2], {k, 2, 9}, {k2, 2, k-1}]] // TestEvaluate // SummarizeTests",
   "languageId": "wolfram",
