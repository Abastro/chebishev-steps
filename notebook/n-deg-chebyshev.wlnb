  {
   "kind": 2,
   "value": "SummarizeTests[tests_] := Grid[\n  Prepend[\n    Table[{test[\"TestID\"], test[\"Outcome\"], test[\"ExpectedOutput\"], test[\"ActualOutput\"]}, {test, tests}],\n    {\"ID\", \"Outcome\", \"Expected\", \"Actual\"}\n  ],\n  Frame -> True\n]",
   "languageId": "wolfram",
   "outputs": [],
